# Copie para .env (o .env não vai para o git).
# No Railway: Variables → cole cada chave abaixo.
# Também dá para colar na própria página Investigar (vale só naquela sessão).

# ══════════════════════════════════════════════════════════════════════════
# A CHAVE QUE MAIS IMPORTA
# ══════════════════════════════════════════════════════════════════════════
# Sem uma SERP API a busca de superfície não funciona a partir do servidor:
# Google, DuckDuckGo e Mojeek bloqueiam IP de datacenter. É por causa disso
# que "o Google acha mais que o Holmes". Com a chave, o motor roda de 10 a 15
# dorks por alvo e classifica cada resultado sozinho.
#
# serper.dev — 2.500 buscas grátis, depois ~US$50/50k. Melhor custo-benefício.
SERPER_API_KEY=

# Alternativas (o motor usa a primeira que encontrar, nesta ordem):
# BRAVE_API_KEY=          # 2.000 buscas/mês grátis, índice próprio
# GOOGLE_CSE_KEY=         # Google Custom Search — 100/dia grátis
# GOOGLE_CSE_CX=          # id do mecanismo (obrigatório junto do GOOGLE_CSE_KEY)

# ══════════════════════════════════════════════════════════════════════════
# IA — análise do dossiê, desambiguação de homônimo e chat
# ══════════════════════════════════════════════════════════════════════════
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# CLAUDE_API_KEY=   # alias opcional da chave Anthropic

# Opcionais
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# ══════════════════════════════════════════════════════════════════════════
# OPCIONAIS — cada uma liga um conector automático a mais.
# Sem elas o serviço continua na lista, mas como link (não como consulta).
# ══════════════════════════════════════════════════════════════════════════
# PORTAL_TRANSPARENCIA_KEY=   # CGU — PEP, CEIS, CNEP e servidor federal. GRÁTIS por e-mail:
#                             # portaldatransparencia.gov.br/api-de-dados/cadastrar-email
#                             # É a melhor chave gratuita para investigação no Brasil.
# HIBP_API_KEY=           # Have I Been Pwned (~US$3.95/mês) — vazamentos por e-mail
# HUNTER_API_KEY=         # Hunter.io — e-mails e padrão de e-mail de um domínio (25/mês grátis)
# NUMVERIFY_API_KEY=      # NumVerify — operadora e tipo de linha (100/mês grátis)
# SHODAN_API_KEY=         # Shodan — portas e serviços expostos
# IPINFO_TOKEN=           # IPinfo — ASN e geolocalização de IP
# LEAKCHECK_API_KEY=      # LeakCheck
# DEHASHED_USER=          # Dehashed (usuário + chave)
# DEHASHED_API_KEY=

# OSINT Leak (API oficial, paga). Sem esta chave o menu Leaks só abre o dashboard.
# Dashboard → Profile → API Settings. Não commite a chave.
# OSINTLEAK_API_KEY=

# ══════════════════════════════════════════════════════════════════════════
# Ajustes do motor (opcional)
# ══════════════════════════════════════════════════════════════════════════
# HOLMES_CACHE_DIR=.holmes_cache
# HOLMES_CACHE_TTL=86400  # segundos; 0 desliga o cache
