# Copie para .env (o .env não vai para o git).
# No Railway: Variables → cole cada chave abaixo.
# Também dá para colar na própria página Investigar (vale só naquela sessão).

# ══════════════════════════════════════════════════════════════════════════
# A CHAVE QUE MAIS IMPORTA
# ══════════════════════════════════════════════════════════════════════════
# Sem uma SERP API a busca de superfície não funciona a partir do servidor:
# Google, DuckDuckGo e Mojeek bloqueiam IP de datacenter. É por causa disso
# que "o Google acha mais que o Holmes". Com a chave, o motor roda de 10 a 15
# dorks por alvo e classifica cada resultado sozinho.
#
# serper.dev — 2.500 buscas grátis, depois ~US$50/50k. Melhor custo-benefício.
SERPER_API_KEY=

# Alternativas (o motor usa a primeira que encontrar, nesta ordem):
# BRAVE_API_KEY=          # 2.000 buscas/mês grátis, índice próprio
# GOOGLE_CSE_KEY=         # Google Custom Search — 100/dia grátis
# GOOGLE_CSE_CX=          # id do mecanismo (obrigatório junto do GOOGLE_CSE_KEY)

# ══════════════════════════════════════════════════════════════════════════
# IA — análise do dossiê, desambiguação de homônimo e chat
# ══════════════════════════════════════════════════════════════════════════
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# CLAUDE_API_KEY=   # alias opcional da chave Anthropic

# Opcionais
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# ══════════════════════════════════════════════════════════════════════════
# OPCIONAIS — cada uma liga um conector automático a mais.
# Sem elas o serviço continua na lista, mas como link (não como consulta).
# ══════════════════════════════════════════════════════════════════════════
# PORTAL_TRANSPARENCIA_KEY=   # CGU — PEP, CEIS, CNEP e servidor federal. GRÁTIS por e-mail:
#                             # portaldatransparencia.gov.br/api-de-dados/cadastrar-email
#                             # É a melhor chave gratuita para investigação no Brasil.
# Sanções/PEP internacionais (OpenSanctions) — o caminho GRÁTIS de verdade é o
# índice local, não uma chave. Rode uma vez (e depois semanalmente):
#   python -m holmes.opensanctions_bulk --update
# Ou clique em «Baixar/atualizar agora» na aba Investigar → Avançado.
# HOLMES_OPENSANCTIONS_DIR=/data/opensanctions   # aponte para o Volume do Railway
# OPENSANCTIONS_API_KEY=      # só como reserva, se preferir a API paga deles em vez do
#                             # índice local (cobra por consulta depois do teste de 30 dias)
#
# Wikipédia/Wikidata (biografia, foto, nascimento, cargos) já funciona sem
# nenhuma chave — nada a configurar.
# HIBP_API_KEY=           # Have I Been Pwned (~US$3.95/mês) — vazamentos por e-mail
# HUNTER_API_KEY=         # Hunter.io — e-mails e padrão de e-mail de um domínio (25/mês grátis)
# NUMVERIFY_API_KEY=      # NumVerify — operadora e tipo de linha (100/mês grátis)
# SHODAN_API_KEY=         # Shodan — portas e serviços expostos
# IPINFO_TOKEN=           # IPinfo — ASN e geolocalização de IP
# LEAKCHECK_API_KEY=      # LeakCheck
# DEHASHED_USER=          # Dehashed (usuário + chave)
# DEHASHED_API_KEY=

# OSINT Leak (API oficial, paga). Sem esta chave o menu Leaks só abre o dashboard.
# Dashboard → Profile → API Settings. Não commite a chave.
# OSINTLEAK_API_KEY=

# ══════════════════════════════════════════════════════════════════════════
# Ajustes do motor (opcional)
# ══════════════════════════════════════════════════════════════════════════
# HOLMES_CACHE_DIR=.holmes_cache
# HOLMES_CACHE_TTL=86400  # segundos; 0 desliga o cache

# ══════════════════════════════════════════════════════════════════════════
# GITHUB — token opcional, de graça, e vale muito
# ══════════════════════════════════════════════════════════════════════════
# Sem token a API do GitHub dá 60 requisições/hora POR IP. Num servidor
# compartilhado isso estoura no primeiro alvo e o conector passa a falhar
# em silêncio. Com token são 5.000/hora. Um PAT sem nenhum escopo basta:
# github.com/settings/tokens  →  "Generate new token"  →  não marque nada.
#
# Use esta variável, e não GITHUB_TOKEN: essa costuma já estar ocupada por
# CI, agentes ou proxy corporativo, e mandar o token de outro serviço para o
# GitHub vaza credencial alheia. O motor recusa valores que não tenham cara
# de token do GitHub justamente por isso.
#
# Se o token vencer ou for revogado, o motor segue sem ele (60/h) em vez
# de quebrar, e escreve um aviso no log do Railway. Renove quando aparecer.
# HOLMES_GITHUB_TOKEN=

# ══════════════════════════════════════════════════════════════════════════
# BRIGHT DATA WEB UNLOCKER — rota PAGA, desligada por padrão
# ══════════════════════════════════════════════════════════════════════════
# Só entra em ação quando um site BLOQUEIA a consulta (403/429/captcha).
# Nunca é o caminho principal: a maioria das fontes responde bem direto, e
# cada chamada aqui custa dinheiro (~US$1,50 por mil requisições).
#
# Antes de ligar, meça quanto você realmente precisa disto:
#     python3 scripts/measure_blocking.py --handle umHandleQueExista
# O script não gasta crédito e diz quantos sites bloqueiam de fato.
#
# Precisa das DUAS linhas abaixo para gastar. Só a chave não liga nada.
# BRIGHTDATA_API_KEY=
# HOLMES_UNLOCKER=1
#
# Ajustes finos (opcionais):
# HOLMES_UNLOCKER_ZONE=cli_unlocker   # zona criada pelo `bdata login`
# HOLMES_UNLOCKER_BUDGET=200          # teto de chamadas pagas POR PROCESSO
# HOLMES_UNLOCKER_TIMEOUT=60
#
# O teto existe de propósito: o motor roda ~90 sites em paralelo, e sem
# limite um laço mal fechado queima o crédito antes de alguém perceber.
